{
  "name": "ngx-json-treeview",
  "description": "Display object data in an expandable JSON tree view.",
  "version": "22.1.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Michael J Doyle",
    "email": "michael.james.doyle@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelDoyle/ngx-json-treeview"
  },
  "keywords": [
    "angular",
    "ngx",
    "json",
    "tree",
    "treeview"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:demo",
    "build:lib": "ng build ngx-json-treeview",
    "postbuild:lib": "cpy ./README.md ./dist/ngx-json-treeview && cpy ./LICENSE ./dist/ngx-json-treeview",
    "build:demo": "ng build demo",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "ng": "ng",
    "start": "ng serve",
    "start:demo": "pnpm run build && pnpm run start",
    "test": "ng test --watch=false",
    "watch": "ng build --watch --configuration development",
    "publish:lib": "pnpm publish ./dist/ngx-json-treeview",
    "lint": "pnpm run lint:es && pnpm run lint:style",
    "lint:es": "ng lint",
    "lint:es:fix": "ng lint --fix",
    "lint:fix": "pnpm run lint:es:fix && pnpm run lint:style:fix",
    "lint:style": "stylelint \"projects/**/*.scss\"",
    "lint:style:fix": "stylelint \"projects/**/*.scss\" --fix",
    "prepare": "simple-git-hooks"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "angular-eslint": "22.6.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.5",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
